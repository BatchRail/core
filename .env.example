# ─────────────────────────────────────────────────────────────
# BatchRail Core — Base Sepolia (eip155:84532)
# Copy to .env and fill values
# ─────────────────────────────────────────────────────────────

# Network
NETWORK=eip155:84532
RPC_URL=https://sepolia.base.org

# USDC on Base Sepolia (official Circle testnet)
ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── Facilitator ──────────────────────────────────────────────
# EOA that pays gas and relays claims / settles / refunds
FACILITATOR_PRIVATE_KEY=0x...

# Optional: dedicated receiverAuthorizer (recommended for production)
# If unset, facilitator address is used
RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Port the facilitator HTTP server listens on
FACILITATOR_PORT=4022

# ── Resource server / Channel Manager ────────────────────────
# Address that receives settled funds (payTo)
EVM_ADDRESS=0x...

# Optional local authorizer for claims (self-managed mode)
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Where the resource server points for verify/settle
FACILITATOR_URL=http://localhost:4022

# Channel storage directory (file-based for local dev)
CHANNEL_STORAGE_DIR=./channels

# Claim / settle cadence (seconds)
CLAIM_INTERVAL_SECS=60
SETTLE_INTERVAL_SECS=120
REFUND_INTERVAL_SECS=180
MAX_CLAIMS_PER_BATCH=50

# ── Client (examples) ────────────────────────────────────────
EVM_PRIVATE_KEY=0x...
# Optional dedicated voucher signer
EVM_VOUCHER_SIGNER_PRIVATE_KEY=
