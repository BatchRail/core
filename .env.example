# ─────────────────────────────────────────────────────────────
# BatchRail Core — Base Sepolia (eip155:84532)
# Copy to .env and fill values
# ─────────────────────────────────────────────────────────────

# Network
NETWORK=eip155:84532
RPC_URL=https://sepolia.base.org

# USDC on Base Sepolia (official Circle testnet)
ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ── Facilitator ──────────────────────────────────────────────
# EOA that pays gas and relays claims / settles / refunds
# Needs a little Base Sepolia ETH for gas
FACILITATOR_PRIVATE_KEY=0x...

# Optional: dedicated receiverAuthorizer (recommended)
# If unset, servers must supply EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY
RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Port the facilitator HTTP server listens on
FACILITATOR_PORT=4022

# ── Resource server / Channel Manager ────────────────────────
# Address that receives settled funds (payTo) — does NOT need ETH
EVM_ADDRESS=0x...

# Optional local authorizer for claims (self-managed mode)
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Where the resource server points for verify/settle
FACILITATOR_URL=http://localhost:4022

# Channel storage directory (file-based for local dev)
CHANNEL_STORAGE_DIR=./channels

# Claim / settle cadence (seconds)
CLAIM_INTERVAL_SECS=60
SETTLE_INTERVAL_SECS=120
REFUND_INTERVAL_SECS=180
MAX_CLAIMS_PER_BATCH=50

# ── Client (examples/client) ─────────────────────────────────
# Wallet that OPENS the payment channel (must hold Base Sepolia USDC)
EVM_PRIVATE_KEY=0x...

# Optional dedicated voucher signer (defaults to EVM_PRIVATE_KEY)
EVM_VOUCHER_SIGNER_PRIVATE_KEY=

# Resource server the client pays against
RESOURCE_SERVER_URL=http://localhost:4021
ENDPOINT_PATH=/weather

# How many paid requests to send in one run
NUMBER_OF_REQUESTS=3

# Deposit = maxPrice × multiplier (default 5, min 3)
DEPOSIT_MULTIPLIER=5

# Persist client channel state between runs
CLIENT_CHANNEL_STORAGE_DIR=./client-channels

# Optional: request refund after the request loop
REFUND_AFTER_REQUESTS=false
# REFUND_AMOUNT=   # omit for full remaining balance
