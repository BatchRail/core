{
  "name": "batchrail-core",
  "version": "0.1.0",
  "private": true,
  "description": "BatchRail — x402 batch-settlement facilitator, channel manager & SDKs",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:facilitator": "pnpm --filter @batchrail/facilitator dev",
    "dev:server": "pnpm --filter @batchrail/example-server dev",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
