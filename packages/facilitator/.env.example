# Required on Railway / local
FACILITATOR_PRIVATE_KEY=0x...

NETWORK=eip155:84532
RPC_URL=https://sepolia.base.org

# Optional authorizer (facilitator-delegated claims)
# RECEIVER_AUTHORIZER_PRIVATE_KEY=0x...

# Optional protection — leave unset to keep the public demo open
# How Fran turns this on: Railway → facilitator service → Variables →
#   Add API_KEY = <long random string from password manager> → Redeploy
# Clients then send: X-API-Key: <same>  OR  Authorization: Bearer <same>
# /health and /stats stay open even when API_KEY is set
# To open the demo again: delete API_KEY variable → Redeploy
# API_KEY=
# RATE_LIMIT_PER_MIN=120

# NODE_ENV=production
